# .gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.coverage
.coverage.*
.pytest_cache/
.hypothesis/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Data
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Reports
reports/*
!reports/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage artifacts
coverage.json
coverage.xml
htmlcov/

# Ruff
.ruff_cache/
