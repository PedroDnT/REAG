    "                   c=colors, s=100, alpha=0.6)\n",
    "        \n",
    "        # Linhas de threshold (Z = ±3)\n",
    "        plt.axhline(y=3, color='red', linestyle='--', alpha=0.5, label='Threshold (Z=3)')\n",
